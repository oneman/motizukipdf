# The guided IUT explorer, terminal side.  `make` builds ./iutx.
# The only file taken from ../../src is the table of identifiers, iut_ids.c.
CC      ?= cc
CFLAGS  ?= -O2 -std=c11 -Wall -Wextra -pedantic
NCURSES := $(shell pkg-config --exists ncursesw 2>/dev/null && echo yes)
ifeq ($(NCURSES),yes)
  CFLAGS += -DX_HAVE_NCURSES $(shell pkg-config --cflags ncursesw)
  LIBS   += $(shell pkg-config --libs ncursesw)
endif
OBJS = model.o engine.o main.o tui.o iut_ids.o

iutx: $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS) $(LIBS)

%.o: %.c iutx.h
	$(CC) $(CFLAGS) -c $<

iut_ids.o: ../../src/iut_ids.c ../../src/iut.h
	$(CC) $(CFLAGS) -c -o $@ $<

# regenerate the model for the web app
data: iutx
	( printf '// GENERATED by `make -C explorer/c data` from explorer/c/model.c. Do not edit.\nconst IUTX_MODEL = ' ; \
	  ./iutx json model ; printf ';\nif (typeof module !== "undefined") module.exports = IUTX_MODEL;\n' ) > ../web/data.js

check: iutx
	./iutx check

clean:
	rm -f *.o iutx

.PHONY: data check clean
