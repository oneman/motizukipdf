]

theorem inputs_length : inputs.length = 11 := rfl

/-- Every input is a process of [IUTchI] or [IUTchII] of `docs/PROCESSES.md`,
with the paper recorded correctly. -/
theorem inputs_are_processes :
    inputs.all (fun i => (Process.find? i.id).any fun p =>
      p.paper == i.paper && (i.paper == .IUTchI || i.paper == .IUTchII)) = true := by
  decide +kernel

theorem inputs_id_nodup : (inputs.map (·.id)).Nodup := by decide

/-! ## The steps of the proof: [IUTchIII] §1–§3 -/

/-- Which part of Thm 3.11 a step of the proof feeds. -/
inductive Part where
  /-- the log-theta-lattice and its coricity (§1): the data the construction runs on -/
  | lattice
  /-- (a) tensor packets of log-shells -/
  | packets
  /-- (b) splitting monoids of the LGP-monoids -/
  | splitting
  /-- (c) the global realified Frobenioids `(F^⊛_mod)_j` -/
  | global
  /-- the log-volume bookkeeping that feeds Cor 3.12 -/
  | logVolume
  /-- the statement: multiradiality up to (Ind1,2,3) -/
  | multiradial
  deriving DecidableEq, Repr

/-- One step of the proof of Thm 3.11: a construction of [IUTchIII] §1–§3,
identified with its process of `docs/PROCESSES.md`. -/
structure Step where
  id : String
  ref : String
  part : Part
  /-- the steps it builds on (ids of earlier steps) -/
  dependsOn : List String
  /-- the results of [IUTchI-II] it uses (ids of `inputs`) -/
  usesInputs : List String
  deriving DecidableEq, Repr

/-- The twelve steps of [IUTchIII] §1–§3 that prove Thm 3.11, in order. -/
def steps : List Step := [
  ⟨"MakeLogShells", "[IUTchIII] Def 1.1, Prop 1.2 (v)-(ix)", .packets, [],
    ["ForgetLadder", "BuildMonoids"]⟩,
  ⟨"ApplyLogLinkStrip", "[IUTchIII] Def 1.1, Prop 1.2", .lattice, ["MakeLogShells"],
    ["ForgetLadder"]⟩,
  ⟨"ChainLogLinks", "[IUTchIII] Prop 1.2 (x), Prop 1.3", .lattice, ["ApplyLogLinkStrip"],
    ["GlueHodgeTheaters", "ForgetToDHodgeTheater"]⟩,
  ⟨"DefineLattice", "[IUTchIII] Def 1.4, Rem 1.4.1", .lattice, ["ChainLogLinks"],
    ["LinkThetaUnitsModTors", "AssembleThetaHodgeTheater"]⟩,
  ⟨"CheckBicoric", "[IUTchIII] Thm 1.5", .lattice, ["DefineLattice"],
    ["ForgetToDHodgeTheater", "LinkThetaUnitsModTors"]⟩,
  ⟨"CoricThetaMonoids", "[IUTchIII] Prop 2.1, Thm 2.2, Cor 2.3", .splitting, ["CheckBicoric"],
    ["EvaluateTheta", "BuildMonoids", "Symmetrize"]⟩,
  ⟨"BuildTensorPackets", "[IUTchIII] Prop 3.1-3.3", .packets, ["MakeLogShells", "CheckBicoric"],
    ["BuildProcessions", "Symmetrize"]⟩,
  ⟨"BuildLGPMonoids", "[IUTchIII] Prop 3.4, Prop 3.5", .splitting,
    ["CoricThetaMonoids", "BuildTensorPackets"], ["RigidifyCyclotomes", "BuildMonoids"]⟩,
  ⟨"CompareGlobalVariants", "[IUTchIII] Ex 3.6, Prop 3.7", .global, ["BuildLGPMonoids"],
    ["BuildGlobalRealified"]⟩,
  ⟨"MakePilots", "[IUTchIII] Def 3.8", .logVolume, ["CompareGlobalVariants", "DefineLattice"],
    ["LinkThetaUnitsModTors"]⟩,
  ⟨"NormalizeLogVolumes", "[IUTchIII] Prop 3.9, Prop 3.10", .logVolume, ["MakePilots"],
    ["BuildGlobalRealified"]⟩,
  ⟨"RepresentMultiradially", "[IUTchIII] Thm 3.11", .multiradial,
    ["BuildTensorPackets", "BuildLGPMonoids", "CompareGlobalVariants", "NormalizeLogVolumes"],
    ["Symmetrize", "RigidifyCyclotomes"]⟩
]

theorem steps_length : steps.length = 12 := rfl

theorem steps_id_nodup : (steps.map (·.id)).Nodup := by decide

/-- Every step is an [IUTchIII] process of `docs/PROCESSES.md`. -/
theorem steps_are_processes :
    steps.all (fun s => (Process.find? s.id).any fun p => p.paper == .IUTchIII) = true := by
  decide +kernel

/-- The steps are exactly the [IUTchIII] processes other than
`EstimateLogVolume` (Cor 3.12, which is Stage 1), in the same order. -/
theorem steps_cover_IUTchIII :
    (Process.byPaper .IUTchIII).map (·.id) = steps.map (·.id) ++ ["EstimateLogVolume"] := by
  decide +kernel

/-- Every input a step uses is one of the [IUTchI-II] inputs. -/
theorem steps_inputs :
    steps.all (fun s => s.usesInputs.all fun i => inputs.any (·.id = i)) = true := by
  decide

/-- The dependency order is well-founded: each step depends only on steps
listed *before* it. -/
def acyclic : List Step → List String → Bool
  | [], _ => true
  | s :: rest, seen => s.dependsOn.all (fun d => seen.contains d) && acyclic rest (s.id :: seen)

theorem steps_acyclic : acyclic steps [] = true := by decide

/-- Every input of [IUTchI-II] is used by some step. -/
theorem inputs_used :
    inputs.all (fun i => steps.any fun s => s.usesInputs.contains i.id) = true := by decide

/-- The last step is the theorem itself. -/
theorem thm311_last : (steps.getLast?.map (·.id)) = some "RepresentMultiradially" := by decide

/-- The parts (a), (b), (c) each have at least one step. -/
theorem parts_covered :
    [Part.packets, .splitting, .global, .logVolume, .lattice, .multiradial].all
      (fun p => steps.any fun s => s.part == p) = true := by decide

/-! ## The data (a)(b)(c) of Thm 3.11, constructed from an étale Hodge theater -/

/-- The étale-like log-shells `I(D_v)` of the 0-column ([IUTchIII] Prop 1.2
(iii); `EtaleLogShellConstruction`): constructed from `G_v` alone, hence from
the étale Hodge theater, independently of the row `m`. -/
def etaleLogShells (d : InitialThetaData) : List LogShell :=
  d.V.mapIdx fun i v => ⟨i, v.pStar, ThetaPmEllNFHodgeTheater.logShellRadius v, false, true, 0, 0⟩

@[simp] theorem etaleLogShells_length (d : InitialThetaData) :
    (etaleLogShells d).length = d.V.length := by simp [etaleLogShells]

/-- The `j`-th procession step of the representation: the tensor packet over
`S^±_{j+1}` (a), the value-group generator `q̲^{j²}` of the splitting monoid
(b), and the label `j` of the global copy `(F^⊛_mod)_j` (c). -/
structure PacketStep (j : ℕ) where
  packet : TensorPacket j
  /-- the exponent `j²` of `q̲_v` in the splitting monoid -/
  splittingExp : ℕ
  /-- the label `j ∈ F_l^*` of the global copy, `none` for `j = 0` -/
  globalLabel : Option ℕ

/-- **The data of [IUTchIII] Thm 3.11**: (a) tensor packets, (b) splitting
monoids, (c) global Frobenioids, over an étale Hodge theater, with the
indeterminacies it is defined up to. -/
structure MultiradialData where
  etHT : EtHT
  /-- the étale-like log-shells of the column -/
  shells : List LogShell
  /-- one step for each `j = 0, …, l*` -/
  packetSteps : (j : Fin (etHT.data.LStar + 1)) → PacketStep j
  ind : Indeterminacies

/-- **The construction of Thm 3.11** from an étale Hodge theater: the packets
are the constant packets of the column's étale log-shells, the splitting
exponents are `j²` (Galois evaluation, [IUTchII] Cor 2.8), the global copies
are labelled by `j ∈ F_l^*`, and all three indeterminacies are imposed. -/
def ofEtHT (E : EtHT) : MultiradialData where
  etHT := E
  shells := etaleLogShells E.data
  packetSteps := fun j =>
    ⟨TensorPacket.ofShells j (etaleLogShells E.data), (j : ℕ) ^ 2,
      if (j : ℕ) = 0 then none else some j⟩
  ind := Indeterminacies.all

namespace MultiradialData

/-- (a): every packet of the construction is fixed by (Ind1). -/
theorem ofEtHT_packets_ind1 (E : EtHT) (j : Fin (E.data.LStar + 1)) (σ : Ind1 j) :
    σ • ((ofEtHT E).packetSteps j).packet = ((ofEtHT E).packetSteps j).packet :=
  TensorPacket.smul_ofShells σ _

/-- (a): the log-shells are étale-like (constructed from `G_v`), one per place. -/
theorem ofEtHT_shells_etale (E : EtHT) :
    (∀ s ∈ (ofEtHT E).shells, s.etaleLike = true) ∧ (ofEtHT E).shells.length = E.data.V.length := by
  refine ⟨?_, by simp [ofEtHT]⟩
  intro s hs
  simp only [ofEtHT, etaleLogShells, List.mem_mapIdx] at hs
  obtain ⟨i, _, rfl⟩ := hs
  rfl

/-- (a): the packet over `S^±_{j+1}` carries the column's shells at every label. -/
theorem ofEtHT_packet_apply (E : EtHT) (j : Fin (E.data.LStar + 1)) (i : Fin (j + 1)) :
    ((ofEtHT E).packetSteps j).packet i = etaleLogShells E.data := rfl

/-- (b): the splitting exponents are `0, 1, 4, …, l*²`, i.e. `0` followed by
the exponents of the Θ-pilot (`ThetaPmEllNFHodgeTheater.thetaExps`). -/
theorem ofEtHT_splitting (E : EtHT) :
    (List.finRange (E.data.LStar + 1)).map (fun j => ((ofEtHT E).packetSteps j).splittingExp) =
      0 :: ThetaPmEllNFHodgeTheater.thetaExps E.data := by
  simp only [ofEtHT, ThetaPmEllNFHodgeTheater.thetaExps]
  rw [List.finRange_succ, List.map_cons, List.map_map]
  simp only [Fin.val_zero, Nat.zero_pow (by norm_num : 0 < 2)]
  congr 1
  apply List.ext_getElem
  · simp
  · intro i h1 h2
    simp [Function.comp_def]

/-- (c): the global copies are labelled by `F_l^* = {1, …, l*}`: `l*` of them. -/
theorem ofEtHT_global_length (E : EtHT) :
    ((List.finRange (E.data.LStar + 1)).filterMap
      (fun j => ((ofEtHT E).packetSteps j).globalLabel)).length = E.data.LStar := by
  simp only [ofEtHT]
  rw [List.finRange_succ, List.filterMap_cons_none (by simp), List.filterMap_map]
  have hf : ((fun j : Fin (E.data.LStar + 1) => if (j : ℕ) = 0 then none else some (j : ℕ)) ∘
      Fin.succ) = fun j : Fin E.data.LStar => some ((j : ℕ) + 1) := by
    funext j
    simp [Fin.val_succ]
  rw [hf, List.filterMap_eq_map', List.length_map, List.length_finRange]

/-- The construction is multiradial: it carries (Ind1), (Ind2), (Ind3). -/
theorem ofEtHT_multiradial (E : EtHT) : (ofEtHT E).ind.Multiradial :=
  Indeterminacies.all_multiradial

/-- **APT at the level of the data**: the construction depends only on the
initial Θ-data of the étale Hodge theater — two étale Hodge theaters with
the same data (any two gluings, any indeterminacy) give the same shells,
packets, exponents and labels. -/
theorem ofEtHT_APT (E E' : EtHT) (h : E.data = E'.data) :
    (ofEtHT E).shells = (ofEtHT E').shells ∧
    ∀ j : ℕ, ∀ (hj : j < E.data.LStar + 1) (hj' : j < E'.data.LStar + 1),
      ((ofEtHT E).packetSteps ⟨j, hj⟩).splittingExp =
        ((ofEtHT E').packetSteps ⟨j, hj'⟩).splittingExp ∧
      ((ofEtHT E).packetSteps ⟨j, hj⟩).globalLabel =
        ((ofEtHT E').packetSteps ⟨j, hj'⟩).globalLabel := by
  refine ⟨by simp [ofEtHT, h], fun j hj hj' => ⟨rfl, rfl⟩⟩

/-- The numerical summary of the data: the multiradial representation of
Stage 1 (`MultiradialRep.ofData`). -/
def toMltRep (L : LogData) (M : MultiradialData) : MltRep :=
  MultiradialRep.ofData M.etHT.data 0 L

/-- **Stage 2 feeds Stage 1**: the descent arrow `(dsc)` of [FormIUT] §4
computes exactly the summary of the data constructed here. -/
theorem toMltRep_eq_dsc (L : LogData) (x : BPSEtHT) :
    toMltRep L (ofEtHT x.etHT) = Form.dsc L x := rfl

/-- The procession step `j` of the summary records the log-volume
contribution `−(j²/2l) log q` of the splitting monoid generator `q̲^{j²}`
(Prop 3.9 (iii)): the `thetaShift` of the step is determined by the splitting
exponent. -/
theorem toMltRep_thetaShift (L : LogData) (E : EtHT) (j : Fin (E.data.LStar + 1)) :
    ((toMltRep L (ofEtHT E)).steps[(j : ℕ)]'(by
        simp [toMltRep, MultiradialRep.ofData, ofEtHT]; omega)).thetaShift =
      -((((ofEtHT E).packetSteps j).splittingExp : ℚ) / (2 * E.data.l)) * E.data.logQ L.log := by
  simp [toMltRep, MultiradialRep.ofData, ProcessionStep.mk', ofEtHT]

/-- The procession step `j` has `(j+1)!` possibilities: the order of (Ind1) on
the packet over `S^±_{j+1}` (`card_Ind1`). -/
theorem toMltRep_perms (L : LogData) (E : EtHT) (j : Fin (E.data.LStar + 1)) :
    ((toMltRep L (ofEtHT E)).steps[(j : ℕ)]'(by
        simp [toMltRep, MultiradialRep.ofData, ofEtHT]; omega)).perms = Fintype.card (Ind1 j) := by
  simp [toMltRep, MultiradialRep.ofData, ProcessionStep.mk', card_Ind1]

end MultiradialData

/-! ## Coricity of the data the construction runs on ([FormIUT] §3, (Stp2), (Stp3)) -/

/-- **(Stp2)**: the étale Hodge theater is vertically coric ([IUTchIII] Thm
1.5 (i)): along a log-link, the copies of `G_v` in the mono-analytic core
`D⊢_Δ` of the étale Hodge theaters of the domain and the codomain coincide,
so the whole 0-column has one `etHT` to run the construction on. -/
theorem logLink_shares_etHT_G (dom cod : ThetaPmEllNFHodgeTheater) (i : ℕ)
    (hi : i < (ThetaPmEllNFHodgeTheater.forgetToD
      (ThetaPmEllNFHodgeTheater.applyLogLink dom cod)).DMonoTriangle.loc.length) :
    ((ThetaPmEllNFHodgeTheater.forgetToD
        (ThetaPmEllNFHodgeTheater.applyLogLink dom cod)).DMonoTriangle.loc[i]).G =
      ((ThetaPmEllNFHodgeTheater.forgetToD dom).DMonoTriangle.loc[i]'(by
        simp [ThetaPmEllNFHodgeTheater.forgetToD, PrimeStrip.forget,
          ThetaPmEllNFHodgeTheater.applyLogLink, ThetaPmEllNFHodgeTheater.shareEtale] at hi
        simp [ThetaPmEllNFHodgeTheater.forgetToD, PrimeStrip.forget]; omega)).G := by
  simp [ThetaPmEllNFHodgeTheater.forgetToD, PrimeStrip.forget, LocalDatum.forget,
    ThetaPmEllNFHodgeTheater.applyLogLink, ThetaPmEllNFHodgeTheater.shareEtale,
    PrimeStripKind.isEtaleLike, PrimeStripKind.isMonoAnalytic]

/-- The log-link preserves the initial Θ-data, so the Stage 2 construction on
the étale Hodge theaters of the two ends of a log-link gives the same data
(`ofEtHT_APT`). -/
theorem logLink_data (dom cod : ThetaPmEllNFHodgeTheater) :
    (ThetaPmEllNFHodgeTheater.applyLogLink dom cod).data = cod.data := rfl

/-- **(Stp3)**: the mono-analytic part of the étale Hodge theater is
horizontally coric ([IUTchIII] Thm 1.5 (ii)): across a `Θ×μ_LGP`-link, the
copies of `G_v` in `D⊢_Δ` of the codomain's étale Hodge theater are those of
the domain's `F⊩_LGP` — the `(0,0)^ℓ ⇔ (1,0)^ℓ` identification of
[FormIUT] §3, which is what lets the construction on the codomain's `etHT`
be read in the domain. -/
theorem thetaLink_shares_etHT_G (dom cod : ThetaPmEllNFHodgeTheater) (i : ℕ)
    (hi : i < (ThetaPmEllNFHodgeTheater.forgetToD
      (ThetaPmEllNFHodgeTheater.applyThetaLink .ThetaUnitsModTorsLGPTorsorLink dom cod)).DMonoTriangle.loc.length) :
    ((ThetaPmEllNFHodgeTheater.forgetToD
        (ThetaPmEllNFHodgeTheater.applyThetaLink .ThetaUnitsModTorsLGPTorsorLink dom cod)).DMonoTriangle.loc[i]).G =
      (dom.FMonoGlobLGP.loc[i]'(by
        simp [ThetaPmEllNFHodgeTheater.forgetToD, PrimeStrip.forget,
          ThetaPmEllNFHodgeTheater.applyThetaLink, ThetaPmEllNFHodgeTheater.shareGUnits,
          ThetaPmEllNFHodgeTheater.thetaSource] at hi
        omega)).G := by
  simp [ThetaPmEllNFHodgeTheater.forgetToD, PrimeStrip.forget, LocalDatum.forget,
    ThetaPmEllNFHodgeTheater.applyThetaLink, ThetaPmEllNFHodgeTheater.shareGUnits,
    ThetaPmEllNFHodgeTheater.thetaSource, PrimeStripKind.isEtaleLike,
    PrimeStripKind.isMonoAnalytic]

/-! ## From Thm 3.11 to the common-container comparison -/

/-- A **log-volume space** ([IUTchIII] Prop 3.9; [IUTchI] Prop 1.2 (iv) in
[AbsTopIII]): the common container `Ω` (the ring structure in which the
simultaneous comparison takes place), with a log-volume on its regions that
is monotone with respect to inclusion. -/
structure LogVolumeSpace where
  Ω : Type
  vol : Set Ω → ℚ
  vol_mono : ∀ {A B : Set Ω}, A ⊆ B → vol A ≤ vol B

/-- **[IUTchIII] Thm 3.11 with Def 3.8 and Prop 3.9–3.10**, as the hypotheses
of Stage 2 in the common container of the fourth triangle: the regions of
the q-pilot (via `(SHE)`), of the Θ-pilot transported by the Θ-link, and of
the multiradial representation after `hull+det` (via `(HDD)`), such that

* (Def 3.8 (ii)) the Θ-link identifies the Θ-pilot of the domain with the
  q-pilot of the codomain, as regions of the container;
* (Thm 3.11 (ii)–(iii), Rem 3.9.5) the transported Θ-pilot lies in the
  representation's region, up to (Ind1,2,3) + hull;
* (Prop 3.9 (iii), Def 3.8) the q-pilot's log-volume is `−|log q|`;
* (Prop 3.9–3.10, the leading-term computation) the container's log-volume
  is the `−|log Θ|` computed by `(HDD)∘(SHE)`.

Each field is a statement of [IUTchIII] whose proof — modulo [IUTchI-II] —
is this stage; none is proved here. -/
structure ThmThreeEleven (L : LogData) (x : QPltEtHT) (S : LogVolumeSpace) where
  qRegion : Set S.Ω
  thetaRegion : Set S.Ω
  container : Set S.Ω
  theta_link : thetaRegion = qRegion
  theta_sub_container : thetaRegion ⊆ container
  vol_q : S.vol qRegion = -(x.etHT.data.absLogQ L.log)
  vol_container : S.vol container = (Form.HDDSHE L x).logVolume

/-- **Thm 3.11 ⟹ "3.11.5"**: the comparison in the common container, the one
hypothesis Stage 1 left open, follows from the hypotheses above by
monotonicity of the log-volume: `−|log q| = vol(q) = vol(Θ) ≤ vol(container)
= −|log Θ|`. -/
theorem thmThreeElevenFive_of_thmThreeEleven (L : LogData) (x : QPltEtHT)
    (S : LogVolumeSpace) (T : ThmThreeEleven L x S) : Form.ThmThreeElevenFive L x := by
  unfold Form.ThmThreeElevenFive
  rw [← T.vol_q, ← T.vol_container, ← T.theta_link]
  exact S.vol_mono T.theta_sub_container

/-- **Thm 3.11 ⟹ Cor 3.12** (Stages 2 and 1 together): the bound
`|log q| ≤ hull / (N − 1)`. -/
theorem corThreeTwelve_of_thmThreeEleven (L : LogData) (x : QPltEtHT)
    (hd : x.etHT.data.WellFormed) (S : LogVolumeSpace) (T : ThmThreeEleven L x S) :
    Form.CorThreeTwelve L x :=
  Form.corThreeTwelve_of_thmThreeElevenFive L x hd (thmThreeElevenFive_of_thmThreeEleven L x S T)

/-- The unfolded form: `log q ≤ (12 l (l* + 3) / (l(l+1) − 12)) · log d^K`. -/
theorem corThreeTwelve_unfolded_of_thmThreeEleven (L : LogData) (x : QPltEtHT)
    (hd : x.etHT.data.WellFormed) (S : LogVolumeSpace) (T : ThmThreeEleven L x S) :
    x.etHT.data.logQ L.log ≤
      (12 * x.etHT.data.l * (x.etHT.data.LStar + 3) / (x.etHT.data.l * (x.etHT.data.l + 1) - 12)) *
        L.logdK :=
  Form.corThreeTwelve_unfolded L x hd (thmThreeElevenFive_of_thmThreeEleven L x S T)

/-- The toy of [FormIUT] §3 in the same shape: a container `Ω` holding the
image of the `N`-th power map; log-volumes are `−(height)`, the image's is
`N` times the domain's, the container is at most `C` bigger than the image,
and the domain sits in the container; then the height `h = −vol(dom)` is
bounded by `C/(N−1)`. -/
theorem toy_of_container (S : LogVolumeSpace) (dom img cont : Set S.Ω) (N C : ℚ) (hN : 1 < N)
    (himg : S.vol img = N * S.vol dom) (hcont : S.vol cont ≤ S.vol img + C) (hsub : dom ⊆ cont) :
    -(S.vol dom) ≤ C / (N - 1) := by
  apply Form.height_bounded_of_dilation N _ C hN
  have := S.vol_mono hsub
  linarith

/-- The two stages as mutation-histories: Stage 2 is the twelve steps as a
chained path of [IUTchIII] processes feeding `RepresentMultiradially`, and
Stage 1 continues with `EstimateLogVolume` (Cor 3.12). -/
theorem stage_two_then_one :
    (Process.byPaper .IUTchIII).map (·.id) =
      steps.map (·.id) ++ ["EstimateLogVolume"] ∧
    steps.getLast?.map (·.id) = some "RepresentMultiradially" :=
  ⟨steps_cover_IUTchIII, thm311_last⟩

end StageTwo

end IUT
