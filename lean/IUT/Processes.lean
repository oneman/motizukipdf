namespace Process

/-- There are 73 processes. -/
theorem processes_length : processes.length = 73 := by decide +kernel

/-- Every process id is a non-empty string of English letters. -/
theorem processes_lettersOnly : processes.all (fun p => lettersOnly p.id) = true := by
  decide +kernel

/-- The process ids are pairwise distinct, even case-insensitively. -/
theorem processes_nodup : (processes.map fun p => ciKey p.id).Nodup := by
  decide +kernel

/-- Hence also distinct as plain strings. -/
theorem processes_id_nodup : (processes.map Process.id).Nodup := by
  have h := processes_nodup
  rw [show (processes.map fun p => ciKey p.id) = (processes.map Process.id).map ciKey by
    simp [List.map_map, Function.comp_def]] at h
  exact List.Pairwise.of_map ciKey (fun _ _ hab e => hab (by rw [e])) h

/-- Every process is an entry of kind `process` of the master identifier
table (`docs/IDENTIFIERS.md`). -/
theorem processes_mem_identifiers :
    processes.all (fun p => (findIdent p.id).any (·.kind = .process)) = true := by
  decide +kernel

/-- Conversely the process entries of the master table are exactly the
processes, in the same order: `docs/PROCESSES.md` and `docs/IDENTIFIERS.md`
agree. -/
theorem processIdentifiers_eq : processIdentifiers.map Ident.id = processes.map Process.id := by
  decide +kernel

/-- Look up a process by id. -/
def find? (id : String) : Option Process := processes.find? (·.id = id)

/-- The processes implementing a given paper. -/
def byPaper (p : Paper) : List Process := processes.filter (·.paper = p)

/-- How many processes each paper contributes: 34 for [IUTchI] (the paper of
the data types), 8, 13, 10 for [IUTchII]–[IUTchIV], 3 for [EssLgc] and 5 for
[Alien]. -/
theorem processes_byPaper :
    Paper.all.map (fun p => (byPaper p).length) = [34, 8, 13, 10, 3, 5] := by
  decide +kernel

/-- The per-paper counts add up to the total. -/
theorem processes_byPaper_sum :
    (Paper.all.map fun p => (byPaper p).length).sum = processes.length := by
  decide +kernel

/-- The processes whose only input is initial Θ-data: the constructions that
start the theory from scratch. -/
def fromInitialData : List Process := processes.filter (·.inputs = "InitialThetaData")

theorem fromInitialData_length : fromInitialData.length = 23 := by decide +kernel

end Process

end IUT
