import IUT.Identifiers

/-!
# The processes — `docs/PROCESSES.md`

The C program organises the *constructions* of the theory (as opposed to its
data types) as **processes**: each row of `docs/PROCESSES.md` (generated by
`iut procs --md` from `src/iut_proc.c`) names a C function family of
`src/iut_ops_*.c`, the paper and section it implements, its inputs and its
outputs.  This file is the same table as a Lean list `processes`, together
with the facts the C sanity checks assert about it:

* `processes_length`: there are 73 processes;
* `processes_lettersOnly`, `processes_id_nodup`: the ids are English-letter
  identifiers and pairwise distinct;
* `processes_mem_identifiers`: every process id is an entry of kind
  `process` of the master identifier table, and conversely
  (`processIdentifiers_eq`) the process entries of the master table are
  exactly the processes, in the same order;
* `processes_byPaper`: how many processes each paper contributes.
-/

namespace IUT

/-- The papers a process may implement. -/
inductive Paper where
  | IUTchI | IUTchII | IUTchIII | IUTchIV | EssLgc | Alien
  deriving DecidableEq, Repr

/-- The citation key of a paper. -/
def Paper.text : Paper → String
  | .IUTchI => "IUTchI"
  | .IUTchII => "IUTchII"
  | .IUTchIII => "IUTchIII"
  | .IUTchIV => "IUTchIV"
  | .EssLgc => "EssLgc"
  | .Alien => "Alien"

/-- All papers, in the order of the C enumeration. -/
def Paper.all : List Paper := [.IUTchI, .IUTchII, .IUTchIII, .IUTchIV, .EssLgc, .Alien]

/-- One row of `docs/PROCESSES.md`. -/
structure Process where
  /-- the identifier (also the name of the C function family and `iut run <id>`) -/
  id : String
  /-- the paper implemented -/
  paper : Paper
  /-- the section(s) of that paper -/
  section_ : String
  /-- what the process does -/
  process : String
  /-- the input species -/
  inputs : String
  /-- the output species -/
  outputs : String
  deriving DecidableEq, Repr

